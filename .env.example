VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Add these as Supabase Edge Function secrets (server-side only).
# Do not prefix them with VITE_ or commit real values.
MOOLRE_API_USER=your-moolre-api-user
MOOLRE_API_PUBKEY=your-moolre-public-api-key
MOOLRE_ACCOUNT_NUMBER=your-moolre-account-number
MOOLRE_WEBHOOK_SECRET=your-moolre-webhook-secret

# Optional: defaults to the live API URL. Use the sandbox URL for sandbox keys.
# MOOLRE_BASE_URL=https://api.moolre.com
# Optional sandbox-only OTP helper.
# MOOLRE_SKIP_OTP=false
